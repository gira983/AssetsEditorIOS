<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <SelfContained>true</SelfContained>
    <NativeLib>Static</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>false</StripSymbols>
    <PublishTrimmed>true</PublishTrimmed>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AssetToolsBridge.Managed\AssetToolsBridge.Managed.csproj" />
  </ItemGroup>
  <Target Name="WriteNativeAotLinkerInputs" AfterTargets="Publish">
    <PropertyGroup>
      <NativeAotLinkerInputFile>$(PublishDir)nativeaot-linker-inputs.txt</NativeAotLinkerInputFile>
    </PropertyGroup>
    <ItemGroup>
      <NativeAotLinkerInput Include="$(IlcSdkPath)libbootstrapperdll.o" />
      <NativeAotLinkerInput Include="$(IlcSdkPath)libRuntime.WorkstationGC.a" />
      <NativeAotLinkerInput Include="$(IlcSdkPath)libeventpipe-disabled.a" />
      <NativeAotLinkerInput Include="$(IlcSdkPath)libRuntime.VxsortDisabled.a" />
      <NativeAotLinkerInput Include="$(IlcSdkPath)libstandalonegc-disabled.a" />
      <NativeAotLinkerInput Include="$(IlcSdkPath)libaotminipal.a" />
      <NativeAotLinkerInput Include="$(IlcSdkPath)libstdc++compat.a" />
      <NativeAotLinkerInput Include="$(IlcFrameworkNativePath)libSystem.Native.a" />
      <NativeAotLinkerInput Include="$(IlcFrameworkNativePath)libSystem.IO.Compression.Native.a" />
      <NativeAotLinkerInput Include="$(IlcFrameworkNativePath)libSystem.Security.Cryptography.Native.Apple.a" />
    </ItemGroup>
    <WriteLinesToFile File="$(NativeAotLinkerInputFile)" Lines="@(NativeAotLinkerInput)" Overwrite="true" />
  </Target>
</Project>
